# ==============================================================================
# PROOFLINE — ENTERPRISE BRAND GOVERNANCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database Connection
# Default local SQLite. In production, configure PostgreSQL.
DATABASE_URL=sqlite:///./brandroots.db
# DATABASE_URL=postgresql://proofline_user:secure_password@localhost:5432/proofline_db

# Security & Cryptographic Signing
SECRET_KEY=proofline-secure-enterprise-jwt-key-change-in-production-random-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI & LLM Provider Configuration
# Supported providers: 'hybrid_deterministic' (built-in offline safe), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=hybrid_deterministic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# File Processing & Object Storage Limits
MAX_UPLOAD_SIZE_BYTES=26214400
UPLOAD_DIR=./uploads
STORAGE_BACKEND=local

# Optional Cloud Services (Supabase / S3)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
