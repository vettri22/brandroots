# ==============================================================================
# BRANDROOTS — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Inkloom AI Hackathon Round 2 | Team: vettriselvam190
# ==============================================================================

# Application Mode
ENVIRONMENT=development
DEMO_MODE=true

# Database Connection
# Local default uses zero-dependency SQLite. For production, set PostgreSQL / Supabase URL.
DATABASE_URL=sqlite:///./brandroots.db
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Security & Session Authentication
SECRET_KEY=brandroots-hackathon-round2-inkloom-secret-key-vettriselvam190
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Compliance Engine
# Supported: 'hybrid_deterministic' (built-in, offline safe) or 'openai' / 'anthropic' / 'gemini'
LLM_PROVIDER=hybrid_deterministic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Supabase Managed Services (Optional for Cloud Deploy)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760
